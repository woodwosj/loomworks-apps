<odoo>
  <record id="sale_order_form_inherit_split" model="ir.ui.view">
    <field name="name">sale.order.form.split.button</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button type="object"
                name="action_open_split_assign"
                string="Split Sale Order"
                class="btn-secondary"
                groups="base.group_user"/>
      </header>
    </field>
  </record>
</odoo>
