<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Replace the single PDF Download button on /my/invoices/<id> with a
        split button: primary action stays PDF (preserving the existing UX
        for users who only want the PDF), and a dropdown adds CSV.
    -->
    <template id="portal_invoice_page_csv_button"
              inherit_id="account.portal_invoice_page"
              name="Portal invoice PDF/CSV download dropdown">
        <xpath expr="//a[hasclass('o_download_btn')]" position="replace">
            <div class="btn-group flex-grow-1" role="group">
                <a class="btn btn-light o_download_btn"
                   t-att-href="invoice.get_portal_url(report_type='pdf', download=True)"
                   title="Download PDF"
                   role="button">
                    <i class="fa fa-download"/> Download
                </a>
                <button type="button"
                        class="btn btn-light dropdown-toggle dropdown-toggle-split"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item"
                           t-att-href="invoice.get_portal_url(report_type='pdf', download=True)">
                            <i class="fa fa-file-pdf-o me-1"/>PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           t-attf-href="/my/invoices/{{ invoice.id }}/csv?access_token={{ invoice.access_token or '' }}">
                            <i class="fa fa-file-text-o me-1"/>CSV (with barcodes)
                        </a>
                    </li>
                </ul>
            </div>
        </xpath>
    </template>
</odoo>
