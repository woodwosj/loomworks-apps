<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="lw_cc_bin_record_view_list" model="ir.ui.view">
        <field name="name">lw_cc.bin.record.view.list</field>
        <field name="model">lw_cc.bin.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="bin_start"/>
                <field name="bin_end"/>
                <field name="card_type"/>
                <field name="network"/>
                <field name="issuer"/>
                <field name="country_code"/>
            </list>
        </field>
    </record>

    <record id="lw_cc_bin_record_view_form" model="ir.ui.view">
        <field name="name">lw_cc.bin.record.view.form</field>
        <field name="model">lw_cc.bin.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="bin_start"/>
                        <field name="bin_end"/>
                        <field name="card_type"/>
                        <field name="network"/>
                        <field name="issuer"/>
                        <field name="country_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="lw_cc_bin_record_action" model="ir.actions.act_window">
        <field name="name">BIN Records</field>
        <field name="res_model">lw_cc.bin.record</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
